#!/bin/bash
#
# cz-pdns-backup --- restart power dns primary and replicas
#
# Copyright 2025, CZ Software

##############################################################################
# Subroutines
##############################################################################

function help_em {
    echo "Usage: cz-pdns-backup help|now"
    exit 1
}

##############################################################################
# Main routine
##############################################################################

if [ "$1" = "" ];     then help_em; fi
if [ "$1" = "help" ]; then help_em; fi

confFile="/etc/cz-pdns-primary.conf"
if [ -e $confFile ]
then
    source $confFile
fi
if [ "$BACKUP_DIR" = "" ]
then
   thisHost=`hostname`
   thisDate=`date --iso-8601`
   BACKUP_DIR="/afs/.ca-zephyr.org/backup/dns/$thisHost/$thisDate"
fi
if [ "$KEYTAB" = "" ]
then
    KEYTAB='/etc/krb5.keytab'
fi

if [ -e $KEYTAB ]
then
    KRB="k5start -f $KEYTAB -U -t -- "
else
    KRB=""
fi

if [ ! -e $BACKUP_DIR ]
then
    cmd="$KRB mkdir -vp $BACKUP_DIR"
    echo "Executing: $cmd"
    $cmd
fi

cmd="$KRB cp -v /var/lib/powerdns/zones.master.d/* $BACKUP_DIR/"
echo "Executing: $cmd"
$cmd

exit

DOCS=<<__END_OF_DOCS__

=head1 NAME

cz-pdns-backup - Copy current Power DNS zones to backup directory

=head1 SYNOPSIS

cz-pdns-backup now

=head1 DESCRIPTION

This script is intended to run on a Power DNS primary server and
copies the current zone files to a backup location.  The default
backup location is of the form /afs/.ca-zephyr.org/<host>/<date>.  The
script assumes that the host keytab can be used to obtain AFS
credentials to access the backup location.  If the command line
parameter is anything other than empty or "help" then a backup if
performed.

The script reads backup location from the configuration file
/etc/cz-pdns-primary.conf if it exists.  The configuration file is a
bash fragment that defines the variable BACKUP_DIR.

